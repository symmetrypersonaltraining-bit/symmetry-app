# Every environment variable this app reads. Copy to .env.local for local work,
# or set them in the Vercel project for a deployment.
#
# This file used to list four of them. The code reads fifteen. Standing up a
# second instance from this repo meant discovering the other eleven by watching
# things fail one at a time, which is most of why Dylan's instance ended up a
# fork rather than a configuration.
#
# REQUIRED means the app is broken without it. Everything else degrades to a
# feature being off, which is a fine state for a new instance to start in.

# ── Supabase — REQUIRED ───────────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side admin (creating auth users, sending invites, cron jobs).
# Secret. Never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Who the trainer is ────────────────────────────────────────────────────────
# Comma-separated. Defaults to Dustin's address when unset, which is why the
# live instance needs nothing here. A second instance MUST set it.
#
# This decides which controls get DRAWN. It grants nothing — access is enforced
# by is_trainer() and RLS in the database, so this address must ALSO have a row
# in public.trainers or the person gets a trainer-shaped screen with no data in
# it. See docs/ADDING-A-TRAINER.md.
NEXT_PUBLIC_TRAINER_EMAILS=trainer@example.com

# ── The coach's name, as clients read it ─────────────────────────────────────
# About a hundred places name the coach in client-facing copy and inside the AI
# prompts that write in his voice: "Send to Dustin", "Your answer for Dustin…",
# the trainer sidebar, the PWA manifest, the weekly focus line.
#
# Getting this wrong does not break anything, which is exactly why it matters —
# it works perfectly and names the wrong human, so a second trainer's clients
# are told to go and talk to Dustin. There is no error to notice.
#
# Unset, it is Dustin. The first name is derived, so there is nothing else to set.
NEXT_PUBLIC_COACH_NAME=Their Full Name
# Used in AI prompts and anywhere the studio is named. Defaults to Symmetry.
NEXT_PUBLIC_BUSINESS_NAME=Their Studio Name

# ── App URL — REQUIRED ────────────────────────────────────────────────────────
# Used in invite email redirects. Wrong value = invite links land on the wrong
# instance, which on a shared repo is a genuinely confusing failure.
NEXT_PUBLIC_APP_URL=https://your-vercel-url.vercel.app

# ── Claude — REQUIRED for every AI feature ────────────────────────────────────
# Read in 29 places: meal parsing, plan building, photo analysis, the coach
# bot, nudges, the weekly brief, the workout builder.
#
# PER DEPLOYMENT. Each instance brings its own key and pays its own bill.
# Sharing one key across instances means the other instance's usage counts
# toward YOUR $95 monthly kill switch (src/lib/ai/meter-core.ts) and can pause
# AI for YOUR clients. Don't share it.
#
# Spend is metered per instance automatically, because ai_usage_log lives in
# each instance's own database.
ANTHROPIC_API_KEY=sk-ant-...

# ── Cron — REQUIRED if the scheduled jobs should run ──────────────────────────
# Shared secret guarding /api/cron/*: birthdays, the coach bot, weekly AI,
# reminders. Any long random string; must match the caller.
CRON_SECRET=generate-a-long-random-string

# ── Optional: transactional email (Resend) ────────────────────────────────────
# Off without it. Message alerts and celebration emails simply don't send.
RESEND_API_KEY=re_...

# ── Optional: Google Calendar sync ────────────────────────────────────────────
# Off without both. Session sync to the trainer's calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional: push notifications (Firebase) ───────────────────────────────────
# The whole service-account JSON, on one line.
FCM_SERVICE_ACCOUNT_JSON=

# ── Optional: branding and the Android build ──────────────────────────────────
# Where the "Install the app" button points.
NEXT_PUBLIC_ANDROID_APK_URL=
# Overrides the Symmetry logo. A second instance almost certainly wants this.
NEXT_PUBLIC_LOGO_URL=

# ── Optional: the peak-week schedule freeze ──────────────────────────────────
# The one client whose week is frozen. Empty = the freeze is off, which is the
# right setting for any instance that is not running a shoot prep.
NEXT_PUBLIC_PEAK_WEEK_CLIENT_ID=

# ── Set by Vercel automatically — do not set by hand ──────────────────────────
# VERCEL_GIT_COMMIT_SHA
